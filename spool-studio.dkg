    {
      "path": "tests/completion.test.ts",
      "bytes": 5088,
      "sha256": "b9785e987f36c3c1e8f830db483a9e7e34f11ee3a5393ac9e57ed7231cd971ca",
      "role": "Regression test or fixture.",
