      ],
      "tests": [
        "lays out the panel sheet as the engineer designed it, 32 item rows then the summary",
        "keeps text out of the cells the kW formulas read, so the summary never shows #VALUE!",
        "fills blanks from the catalogue and keeps typed values",
        "works out kW and kVAr like the workbook",
        "sums a panel with operating factors and design margin",
        "compares a candidate model and its effect on the plant",
        "maps panel to From, description to To and rated input power to Design Load",
        "keeps two items with the same name as two rows and re-sends without losing cable inputs",
        "reads room sheets, brand sheets and totals, and skips a search copy",
        "exports a workbook that imports back the same",
        "retains template reactive formula and expands the summary past longer panels",
        "lets old projects open with an empty load list",
        "finds labelled values and checks them against the page",
        "flags values from the local model that are not on the page"
      ],
      "runtime": false
    },
