      ],
      "tests": [
        "never writes Infinity or NaN as a cached Excel number",
        "strips characters XML 1.0 forbids from typed text",
        "treats hex, binary and Infinity spellings as invalid entries",
        "survives extreme magnitudes without throwing",
        "caps long imported text so autosave keeps working",
        "limits the size of a delimited file like a workbook",
        "rejects malformed or hostile JSON with a readable message",
        "drops prototype keys and unknown columns from rows",
        "marks hostile fault inputs invalid or blank, never non-finite",
        "flags a device or CPC outside the workbook lists",
        "exports fault inputs as entered and keeps device names as text",
        "moves step06 and step07 saved fault inputs to their step08 columns once"
      ],
      "runtime": false
    },
    {
