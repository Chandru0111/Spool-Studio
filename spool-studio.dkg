      ],
      "tests": [
        "finds the sizing inputs in a typical load list",
        "recognises every input column of the Cable Sizing sheet by its own header",
        "cleans units, percentages and dropdown names, and skips spacer rows",
        "re-imports an exported workbook with the same inputs",
        "groups runs by product and counts each single core and parallel cable",
        "maps the step08 headings and keeps earthing system, device and CPC type names as text",
        "reads the starter type into the sheet's list names and blanks non-motors"
      ],
      "runtime": false
    },
