        "../src/store/schema",
        "exceljs",
        "vitest"
      ],
      "tests": [
        "converts explicit units and scientific notation without truncating ambiguous values",
        "uses saved XLSX formula values and leaves missing results blank",
        "accepts only complete supplier drum inputs and binds capacity to cable diameter",
        "does not infer drum geometry from unlabeled OCR numbers",
        "conserves whole runs and responds to the lower lifting limit",
        "reports overlong runs and rejects bending, invalid geometry and excessive counts",
        "marks incomplete electrical designs as preliminary quantities and omits invalid inputs",
        "restores v2 input state, recomputes results and rejects incompatible or invalid geometry"
      ],
      "runtime": false
    },
    {
      "path": "tests/drawing.test.ts",
      "bytes": 11462,
      "sha256": "026282d2f9fd96bc8b3939e93a19a351d6b7bbebea097c74a7d3b5fa87f21d2a",
      "role": "Regression test or fixture.",
      "exports": [],
      "imports": [
        "../src/import/drawing-ocr",
        "../src/import/raster",
        "../src/import/schematic",
        "vitest"
      ],
      "tests": [
        "separates ink from paper, and leaves coloured mark-ups out of the line work",
        "finds straight strokes with their thickness",
        "traces each feeder from the busbar through breaker and fuse symbols to its end",
        "does not take a cable route that bends twice for a busbar",
        "finds breaker boxes even with a feeder through them, but not open letters",
        "maps words read on a turned copy back onto the sheet",
        "keeps upright and vertical words, drops symbol noise and lone letters that follow nothing",
        "treats short words as noise unless they are drawing abbreviations or carry a digit",
        "boxes rotated text and scales geometry consistently",
        "reads an LV board: busbar name and voltage, breaker beside each drop, load at the end",
        "reads an MV network in US notation, naming incomers after their source",
        "reads US cable counts, feet and miles, MW and MVA, and ETAP-style tags",
        "reads a bare C16 as an MCB rating only where the drawing talks about MCBs",
        "copes with noise, huge stroke counts and thousands of words quickly"
      ],
      "runtime": false
    },
