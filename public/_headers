# Security headers for static hosts that read _headers (Cloudflare Pages, Netlify). Keep in step with vercel.json and public/index.html.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob: http://127.0.0.1:11434 http://localhost:11434 http://127.0.0.1:1234 http://localhost:1234; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
